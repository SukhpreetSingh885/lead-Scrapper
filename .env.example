# =====================================================================
# India Leads Platform - Environment Configuration Template
# Copy this file to .env and adjust as necessary for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS.
# =====================================================================

# App Environment
ENVIRONMENT=development
PROJECT_NAME="India Leads Platform"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For Docker or local PostgreSQL with pg_trgm:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/india_leads
# For local zero-dependency testing without Docker, SQLite fallback is supported:
# DATABASE_URL=sqlite:///./india_leads.db

# Redis & Celery Background Processing
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# When running standalone without Redis or running test suites, set CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_ALWAYS_EAGER=False

# Sourcing & Discovery Configuration
# When DEMO_MODE=True, the system provides deterministic test fixtures labeled "DEMO DATA"
# and does not require any paid external API credentials.
DEMO_MODE=True

# External API Integrations (Optional - Live Provider Mode)
# Google Places API (Used for compliant temporary discovery preview only)
GOOGLE_MAPS_API_KEY=
# Google Custom Search API (Optional)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Contact Enrichment Crawler Settings
ENRICHMENT_MAX_PAGES_PER_DOMAIN=4
ENRICHMENT_REQUEST_TIMEOUT_SECONDS=10
ENRICHMENT_RATE_LIMIT_DELAY=1.0
ENRICHMENT_USER_AGENT="IndiaLeadsBot/1.0 (+https://indialeads.internal/compliance-bot)"
SSRF_ALLOWED_PORTS=80,443

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Frontend Environment Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="India Leads Platform"
NEXT_PUBLIC_DEMO_MODE_DEFAULT=true

